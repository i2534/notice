{
  "id": "notice",
  "name": "Notice Channel",
  "version": "0.1.0",
  "description": "Notice channel (MQTT subscribe & publish). Config: channels.notice.",
  "channels": [
    "notice"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "token": {
        "type": "string"
      },
      "brokerUrl": {
        "type": "string"
      },
      "topic": {
        "type": "string",
        "default": "notice/openclaw"
      },
      "serverUrl": {
        "type": "string"
      },
      "blockStreaming": {
        "type": "boolean",
        "default": true
      },
      "blockStreamingBreak": {
        "type": "string",
        "enum": ["text_end", "message_end"],
        "default": "text_end"
      }
    }
  },
  "uiHints": {
    "token": {
      "label": "Token",
      "sensitive": true
    },
    "brokerUrl": {
      "label": "MQTT Broker URL"
    },
    "topic": {
      "label": "Topic (subscribe & publish)"
    },
    "serverUrl": {
      "label": "Notice 服务器 URL (图片上传)"
    },
    "blockStreaming": {
      "label": "按块流式发送",
      "help": "启用后，Agent 回复在生成过程中按块通过 MQTT 发送；关闭则等整条消息结束后再发。"
    },
    "blockStreamingBreak": {
      "label": "发送时机",
      "help": "text_end：每块产出即发送（逐条）；message_end：整条消息结束后再发送。"
    }
  }
}