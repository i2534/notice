{
  "id": "notice",
  "name": "Notice Channel",
  "version": "0.1.0",
  "description": "Notice channel (MQTT subscribe & publish). Config: channels.notice.",
  "channels": [
    "notice"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "token": {
        "type": "string"
      },
      "brokerUrl": {
        "type": "string"
      },
      "topic": {
        "type": "string",
        "default": "notice/openclaw"
      }
    }
  },
  "uiHints": {
    "token": {
      "label": "Token",
      "sensitive": true
    },
    "brokerUrl": {
      "label": "MQTT Broker URL"
    },
    "topic": {
      "label": "Topic (subscribe & publish)"
    }
  }
}