{
    "name": "@notice/notice",
    "version": "0.1.0",
    "description": "Openclaw plugin: Notice channel - send and receive messages via MQTT (Notice broker)",
    "type": "module",
  "engines": {
        "node": ">=22.14.0"
    },
    "files": [
        "openclaw.plugin.json",
        "index.ts",
        "package.json"
    ],
    "openclaw": {
        "extensions": [
            "./index.ts"
        ]
    },
    "channel": {
        "id": "notice",
        "label": "Notice",
        "selectionLabel": "Notice (MQTT)",
        "docsPath": "/channels/notice",
        "blurb": "通过 MQTT 连接 Notice Broker 收发消息。"
    },
    "dependencies": {
        "mqtt": "^5.3.0"
    },
"peerDependencies": {
        "openclaw": "^2026.4.29"
    },
    "scripts": {},
    "devDependencies": {
        "typescript": "^6.0.2"
    }
}
