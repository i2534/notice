<?xml version="1.0" encoding="utf-8"?>
  <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubbleRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="0dp"
    android:layout_marginEnd="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <!-- 气泡背景 -->
    <FrameLayout
        android:id="@+id/bubbleCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_incoming"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <!-- 时间戳 -->
        <TextView
            android:id="@+id/bubbleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            tools:text="10:30" />

        <!-- 内容 -->
        <LinearLayout
            android:id="@+id/bubbleContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
          android:layout_marginStart="14dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <!-- 内容截断提示 -->
        <TextView
            android:id="@+id/bubbleMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/message_content_more"
            android:textColor="@color/primary_light"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- 底部渐变遮罩 -->
        <View
            android:id="@+id/bubbleFade"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="#00000000"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
