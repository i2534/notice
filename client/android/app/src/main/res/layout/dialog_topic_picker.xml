<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_topic_picker">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topic_picker_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Custom input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/topic_picker_custom_hint"
            app:boxBackgroundColor="@color/background"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/text_secondary"
            app:boxCollapsedPaddingTop="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Default option -->
        <FrameLayout
            android:id="@+id/wrapDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp">

            <RadioButton
                android:id="@+id/radioButtonDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/textViewDefaultTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Recent topics header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:text="@string/topic_picker_recent"
            android:textColor="@color/text_hint"
            android:textSize="10sp" />

        <!-- Recent topics list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="150dp" />

    </LinearLayout>
</FrameLayout>
