<?xml version="1.0" encoding="utf-8"?>
<!-- 一体化回复栏：主题选择 + 输入框 + 发送按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/replySection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:background="@color/background">

    <!-- 圆角卡片容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_reply_card"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- 顶部：主题选择行 -->
            <LinearLayout
                android:id="@+id/replyToTopicRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_topic_dot"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/replyToTopicLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:clickable="false" />

                <ImageView
                    android:id="@+id/btnToggleTopicPicker"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    android:contentDescription="@string/topic_picker_title"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/btnClearReplyToTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="✕"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A2A"
                android:layout_marginBottom="8dp" />

            <!-- 底部：输入行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 语音/键盘切换 -->
                <FrameLayout
                    android:id="@+id/btnInputModeToggleWrap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnInputModeToggle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic" />
                </FrameLayout>

                <!-- 输入框 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/replyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/reply_hint"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@null"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/voiceHoldToTalk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:gravity="center"
                        android:text="@string/voice_hold_to_talk"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:paddingVertical="8dp" />
                </FrameLayout>

                <!-- 发送按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendReply"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/primary"
                    app:icon="@drawable/ic_send"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
